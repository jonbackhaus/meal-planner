<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.backhaus.meal-planner</string>

	<!--
	  This daemon owns its OWN weekly trigger: an in-process Scheduler running
	  inside the resident Node process fires plan generation at the Sunday
	  `MP_TRIGGER_TIME` slot, in `MP_TIMEZONE`, DST-correct. Deliberately NO
	  StartCalendarInterval here — launchd's job is ONLY to boot-launch the
	  process and keep it alive; it must never itself invoke a calendar-timed
	  run, or the schedule would be owned in two places at once.
	-->

	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/node</string>
		<!-- Absolute path to the built daemon entrypoint (`pnpm build` output). Update to match this machine's checkout location. -->
		<string>/Users/YOUR_USERNAME/meal-planner/dist/index.js</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/meal-planner</string>

	<key>RunAtLoad</key>
	<true/>

	<key>KeepAlive</key>
	<true/>

	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/meal-planner/logs/meal-planner.out.log</string>

	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/meal-planner/logs/meal-planner.err.log</string>

	<!--
	  Secrets and profile/timezone configuration: launchd does not source your
	  shell's env files, so anything the daemon needs at boot must be listed
	  explicitly here. Keep actual secret VALUES out of this committed plist —
	  install a machine-local copy (not tracked by git) with real values filled
	  in, or source them via the `op` CLI (OP_SERVICE_ACCOUNT_TOKEN below) so
	  no plaintext secret ever needs to live in this file at all.
	-->
	<key>EnvironmentVariables</key>
	<dict>
		<!-- 1Password service-account token (preferred): the daemon reads
		     MP_OP_SLACK_TOKEN_REF / MP_OP_ANTHROPIC_KEY_REF op:// references
		     via the `op` CLI instead of holding secrets directly. -->
		<key>OP_SERVICE_ACCOUNT_TOKEN</key>
		<string>REPLACE_ME_DO_NOT_COMMIT_REAL_VALUE</string>

		<!-- Only needed if NOT using 1Password (env fallback source); still
		     placeholders only, never real values in this committed file. -->
		<key>MP_SLACK_BOT_TOKEN</key>
		<string>REPLACE_ME_DO_NOT_COMMIT_REAL_VALUE</string>
		<key>MP_ANTHROPIC_API_KEY</key>
		<string>REPLACE_ME_DO_NOT_COMMIT_REAL_VALUE</string>

		<key>MP_PROFILE</key>
		<string>prod</string>
		<key>MP_TIMEZONE</key>
		<string>America/Chicago</string>
		<key>MP_TRIGGER_TIME</key>
		<string>06:00</string>

		<!-- ===== v2.0 calendar capacity (OPTIONAL; runbook §8.1) =====
		     OFF by default → daemon behaves exactly like v1.0. To enable, in
		     your machine-local ~/Library/LaunchAgents copy: uncomment these,
		     set MP_CALENDAR_ENABLED to true, list the family's REAL Calendar.app
		     calendar names in MP_CALENDAR_INCLUDE (role "cook" = out/eating-out
		     → NONE; role "logistics" = activity/drive → QUICK), AND grant the
		     "Calendars" TCC to THIS plist's node binary (runbook §0.1 item 3).
		     Without the grant the daemon silently degrades to the static
		     schedule. Names must match Calendar.app exactly. Exclude noisy
		     calendars: "Siri Suggestions" (duplicates) and travel calendars like
		     "TripIt" (multi-day all-day trip banners as role "cook" zero out
		     every night of the trip — cf. bd swl).
		<key>MP_CALENDAR_ENABLED</key>
		<string>true</string>
		<key>MP_CALENDAR_INCLUDE</key>
		<string>[{"name":"Family Schedule","role":"logistics"},{"name":"Appointments","role":"cook"}]</string>
		<key>MP_CALENDAR_COOKING_WINDOW_START</key>
		<string>16:30</string>
		<key>MP_CALENDAR_COOKING_WINDOW_END</key>
		<string>19:30</string>
		<key>MP_QUICK_ACTIVE_MAX</key>
		<string>30</string>
		===== end v2.0 calendar ===== -->

		<!-- ===== v2.0 weather signal (OPTIONAL; runbook §8.1) =====
		     Household lat/lon for the keyless Open-Meteo temperature_band soft
		     signal. Unset = weather skipped (silent). Both must be set.
		<key>MP_WEATHER_LATITUDE</key>
		<string>41.29</string>
		<key>MP_WEATHER_LONGITUDE</key>
		<string>-73.09</string>
		===== end v2.0 weather ===== -->

		<!-- ===== v3.0 revision + Todoist commit (OPTIONAL; runbook §8.2) =====
		     OFF by default → with no Slack app-level token the daemon skips the
		     Socket Mode connection and behaves exactly like v2.0 (outbound-only).
		     To enable: store the app-level (xapp-) + Todoist API tokens in the
		     Meal-Planner 1Password vault and point the *_REF vars at them, set
		     MP_TODOIST_PROJECT_ID_PROD, then reload. No new TCC grant (Socket
		     Mode is network; Todoist is HTTP). Ref paths are config, not secrets.
		<key>MP_OP_SLACK_APP_TOKEN_REF</key>
		<string>op://Meal-Planner/slack-app/socket-mode</string>
		<key>MP_OP_TODOIST_TOKEN_REF</key>
		<string>op://Meal-Planner/todoist-api/credential</string>
		<key>MP_TODOIST_PROJECT_ID_PROD</key>
		<string>REPLACE_WITH_TODOIST_PROJECT_ID</string>
		     Optional (sensible defaults — omit unless overriding):
		     MP_TODOIST_TITLE_TEMPLATE (default "{title}"),
		     MP_TODOIST_RECIPE_LINK_FORMAT (default ""),
		     revision caps MP_REVISION_CYCLE_TOKEN_CAP (150000) /
		     MP_REVISION_THREAD_TURN_CAP (25) / MP_REVISION_THREAD_DOLLAR_CAP (5).
		     (Env-fallback source instead of 1Password: MP_SLACK_APP_TOKEN /
		     MP_TODOIST_API_TOKEN with the raw values.)
		===== end v3.0 ===== -->
	</dict>
</dict>
</plist>
