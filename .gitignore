
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
.beads.gate.lock
# Passive bd exports, regenerated locally; issues sync via refs/dolt/data.
.beads/issues.jsonl
.beads/interactions.jsonl

# Node / build
node_modules/
dist/
*.tsbuildinfo

# Compiled native helper binaries (source is committed; build with `pnpm build:native`)
native/ekreader
native/_CodeSignature/

# Tool caches
.biome-cache/
.vitest-cache/

# Runtime data (SQLite session + recipe index)
data/
# Session-DB backups (bd6.13) + ad-hoc .bak copies (redundant under data/ above,
# listed explicitly so backups are never committed even if data/ is narrowed).
data/backups/
*.bak

# Runtime daemon logs (launchd StandardOut/ErrPath, RUNBOOK §7)
logs/

# Local secret/env files (never commit real tokens); .env.example is safe
.env
*.env
!.env.example
