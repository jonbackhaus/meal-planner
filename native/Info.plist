<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.backhaus.meal-planner.ekreader</string>
	<key>CFBundleName</key>
	<string>ekreader</string>
	<key>CFBundleExecutable</key>
	<string>ekreader</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<!-- macOS 14+ full-access request (requestFullAccessToEvents). Without a
	     usage-description string embedded in the binary, a bare CLI is
	     auto-denied with no prompt (the ob8 revert's blocker). -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Meal Planner reads your family calendar to plan cooking capacity for the week.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Meal Planner reads your family calendar to plan cooking capacity for the week.</string>
</dict>
</plist>
